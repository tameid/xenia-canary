+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2025 Xenia Canary. All rights reserved.                          *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// PHASE 0 SPIKE INSTRUMENTATION - throwaway, apply as:
+//   git apply tools/nui-spike/0001-nui-trace-instrumentation.patch
+//   ... run the dashboard / a NUI title with "Kinect Initialized" ticked ...
+//   git apply -R tools/nui-spike/0001-nui-trace-instrumentation.patch
+//
+// Goal: capture exactly which NUI surface a title touches, with arguments and
+// results, so the out-of-tree Kinect plugin can be specified against real data
+// instead of guesses. Writes a TSV trace next to the emulator storage root and
+// mirrors it into the normal log.
+//
+// cvars:
+//   log_nui_trace        bitmask: 1 exports, 2 messages, 4 notify,
+//                             8 message buffer hexdump, 16 trace *all* exports
+//                             (otherwise only NUI/natal/controlpack/nui-ish ones)
+//   nui_trace_filter     comma separated substrings, overrides the default
+//                             NUI-ish export name filter
+
+#ifndef XENIA_KERNEL_NUI_TRACE_H_
+#define XENIA_KERNEL_NUI_TRACE_H_
+
+#include <cstdint>
+
+#include "xenia/base/cvar.h"
+
+// DEFINE_/DECLARE_ macros open a `namespace cvars {}` at the current scope, so the
+// declarations must live at file scope to match the DEFINE_ in nui_trace.cc.
+DECLARE_int32(log_nui_trace);
+DECLARE_string(nui_trace_filter);
+
+namespace xe {
+namespace kernel {
+
+class KernelState;
+
+namespace nui_trace {
+
+// Trace bit flags (see log_nui_trace).
+enum : int32_t {
+  kTraceExports = 0x1,
+  kTraceMessages = 0x2,
+  kTraceNotify = 0x4,
+  kTraceHexdump = 0x8,
+  kTraceAllExports = 0x10,
+};
+
+// Truncates the trace file and records boot state (xconfig retail flags,
+// title id). Safe to call more than once.
+void Init(KernelState* kernel_state);
+
+// True if the export should be traced given its name (applies the filter).
+bool WantsExport(const char* name);
+
+// Call/return hooks, called from the generated export trampolines.
+// `regs` is PPCContext::r, we only read r3-r10 (xam/xboxkrnl call args).
+void ExportCall(const char* name, uint16_t ordinal, uint32_t thread_id,
+                const uint64_t* regs);
+void ExportRet(const char* name, uint16_t ordinal, uint32_t thread_id,
+               uint64_t result);
+
+// Hook for messages delivered to the xam app (0x2Bxxx / 0x2Cxxx ranges).
+void Message(const char* source, uint32_t app_id, uint32_t message,
+             uint32_t buffer_ptr, uint32_t buffer_length, KernelState* state);
+
+// Hook for XNotifyBroadcast and friends.
+void Notify(const char* name, uint32_t notification, uint32_t data);
+
+void Shutdown();
+
+}  // namespace nui_trace
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_NUI_TRACE_H_
