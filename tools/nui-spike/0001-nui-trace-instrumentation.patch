+// PHASE 0 SPIKE INSTRUMENTATION - throwaway. See nui_trace.h.
+
+#include "xenia/kernel/nui_trace.h"
+
+#include <cstdio>
+#include <cstring>
+#include <chrono>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+#include "xenia/base/clock.h"
+#include "xenia/base/filesystem.h"
+#include "xenia/base/logging.h"
+#include "xenia/emulator.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/xconfig.h"
+#include "xenia/memory.h"
+
+DEFINE_int32(
+    log_nui_trace, 0,
+    "PHASE 0 SPIKE. NUI trace bitmask: 1=exports, 2=messages, 4=notify, "
+    "8=message buffer hexdump, 16=trace all exports (not just NUI-ish names).",
+    "Kernel");
+DEFINE_string(
+    nui_trace_filter, "",
+    "PHASE 0 SPIKE. Comma separated substrings overriding the default NUI-ish "
+    "export name filter.",
+    "Kernel");
+
+namespace xe {
+namespace kernel {
+namespace nui_trace {
+
+namespace {
+
+struct TraceState {
+  // timed_mutex, not mutex: Emit must be able to give up rather than block
+  // forever on a thread that is wedged inside the tracer.
+  std::timed_mutex lock;
+  std::FILE* file = nullptr;
+  uint64_t seq = 0;
+  uint64_t dropped = 0;
+  bool initialized = false;
+};
+
+// Default filter: everything a NUI client could plausibly call.
+constexpr const char* kDefaultFilter[] = {
+    "Nui",  "NUI", "Natal", "ControlPack", "controlpack", "Kinect",
+    "Usbcam", "UsbCam", "Biometric",
+};
+
+TraceState* state() {
+  static TraceState* s = new TraceState();
+  return s;
+}
+
+// Trace flags are captured once, at Init(). Reading the cvar on every call is not
+// safe: xenia rewrites and reloads xenia-canary.config.toml (which persists
+// log_nui_trace = 0) while a title is booting, and the cvar silently drops back to
+// 0 mid-session - which is exactly what happened in an early run, where tracing
+// stopped after 440 events with no error anywhere.
+int32_t g_flags = 0;
+
+std::vector<std::string> FilterSubstrings() {
+  // Cached: WantsExport() runs on every traced export call, and the "trace all
+  // exports" mode makes that hot.
+  //
+  // cached_valid is required: nui_trace_filter defaults to "", and a
+  // default-constructed cached_source is also "". Comparing the two without a
+  // validity flag short-circuits on the very first call and returns the still
+  // empty vector, so the default filter below was never applied and NO export
+  // was ever traced unless log_nui_trace had bit 0x10 set (which bypasses the
+  // filter entirely) or the user passed an explicit non-empty filter.
+  static std::string cached_source;
+  static std::vector<std::string> cached;
+  static bool cached_valid = false;
+  const std::string& configured = cvars::nui_trace_filter;
+  if (cached_valid && configured == cached_source) {
+    return cached;
+  }
+  cached_source = configured;
+  cached_valid = true;
+  cached.clear();
+  if (configured.empty()) {
+    for (auto* s : kDefaultFilter) {
+      cached.emplace_back(s);
+    }
+    return cached;
+  }
+  size_t pos = 0;
+  while (pos <= configured.size()) {
+    size_t next = configured.find(',', pos);
+    if (next == std::string::npos) {
+      next = configured.size();
+    }
+    std::string_view token =
+        std::string_view(configured).substr(pos, next - pos);
+    if (!token.empty()) {
+      cached.emplace_back(token);
+    }
+    pos = next + 1;
+  }
+  return cached;
+}
+
+std::string_view Hexdump(Memory* memory, uint32_t guest_ptr, uint32_t length) {
+  static thread_local std::string buffer;
+  buffer.clear();
+  // TranslateVirtual does no bounds checking, so refuse anything that cannot
+  // possibly be a guest buffer rather than faulting inside the emulator.
+  if (!memory || guest_ptr < 0x10000000 || guest_ptr > 0xC0000000 || !length) {
+    return {};
+  }
+  // Message buffers are small; cap the dump so a runaway length can't explode.
+  const uint32_t capped = length < 256 ? length : 256;
+  buffer.reserve(capped * 3 + 16);
+  const uint8_t* data = memory->TranslateVirtual<uint8_t*>(guest_ptr);
+  for (uint32_t i = 0; i < capped; ++i) {
+    if (i % 16 == 0) {
+      if (i) {
+        buffer.push_back(' ');
+      }
+      char offset[8];
+      snprintf(offset, sizeof(offset), "%04X:", i);
+      buffer.append(offset);
+    }
+    char byte[4];
+    snprintf(byte, sizeof(byte), "%02X", data[i]);
+    buffer.append(byte);
+    if (i % 16 != 15 && i + 1 != capped) {
+      buffer.push_back(' ');
+    }
+  }
+  if (length > capped) {
+    buffer.append("...");
+  }
+  return buffer;
+}
+
+void Emit(const char* kind, const char* name, uint32_t ordinal,
+          uint32_t thread_id, const std::string& detail) {
+  auto* s = state();
+
+  // seq, us, thread id, kind, name, ordinal, detail - all tab separated so the
+  // trace can be diffed/aggregated straight out of the file.
+  //
+  // Formatting happens before the lock (it is pure CPU work and must never be
+  // able to block), and the log mirror happens after it. Holding this lock
+  // across XELOGI deadlocks: another thread can be inside the logging subsystem
+  // and then call a traced export, so tracing waits on logging while logging
+  // waits on tracing. That killed tracing entirely in an early run.
+  char line[4096];
+  {
+    std::unique_lock<std::timed_mutex> guard(s->lock, std::defer_lock);
+    // Bounded wait: if some thread is wedged inside Emit, drop lines instead of
+    // losing the trace for the rest of the session.
+    if (guard.try_lock_for(std::chrono::milliseconds(50))) {
+      // Wall clock, not Clock::QueryHostTickCount(): that one is the guest tick
+      // counter, which barely advances while the guest is idle and made the
+      // timestamps useless for correlating a trace with a log.
+      const auto now = std::chrono::steady_clock::now().time_since_epoch();
+      const uint64_t us = static_cast<uint64_t>(
+          std::chrono::duration_cast<std::chrono::microseconds>(now).count());
+      const uint64_t seq = ++s->seq;
+
+      snprintf(line, sizeof(line), "%llu\t%llu\t%u\t%s\t%s\t0x%04X\t%s\n",
+               static_cast<unsigned long long>(seq),
+               static_cast<unsigned long long>(us), thread_id, kind, name,
+               ordinal, detail.c_str());
+
+      if (s->file) {
+        fputs(line, s->file);
+        // Line-buffered: a crash mid-run still leaves a usable trace.
+        fflush(s->file);
+      }
+    } else {
+      s->dropped++;
+    }
+  }
+  XELOGI("NUI|{}|{}|{}|{}", kind, name, ordinal, detail);
+}
+
+}  // namespace
+
+void Init(KernelState* kernel_state) {
+  g_flags = cvars::log_nui_trace;
+  if (g_flags == 0) {
+    return;
+  }
+  auto* s = state();
+  {
+    std::lock_guard<std::timed_mutex> guard(s->lock);
+    if (s->initialized) {
+      return;
+    }
+    s->initialized = true;
+
+    std::error_code ec = xe::filesystem::CreateFolder(
+        kernel_state->emulator()->storage_root() / "nui_trace");
+    if (ec) {
+      XELOGW("NUI_TRACE: cannot create the trace directory ({})",
+             ec.message());
+      s->file = nullptr;
+    } else {
+      s->file = xe::filesystem::OpenFile(
+          kernel_state->emulator()->storage_root() / "nui_trace" / "trace.tsv",
+          "wt");
+    }
+    if (s->file) {
+      fprintf(s->file, "# seq\tus\tthread\tkind\tname\tordinal\tdetail\n");
+      fflush(s->file);
+    }
+  }
+  // Note: Emit takes the lock itself, so nothing below may hold it.
+
+  // Boot state: the Kinect checkbox (console settings -> "Kinect Initialized")
+  // is what flips the guest into believing a Kinect exists.
+  if (kernel_state->xconfig()) {
+    const uint32_t retail_flags =
+        kernel_state->xconfig()->ReadSetting<uint32_t>(
+            XCONFIG_USER_CATEGORY, XCONFIG_USER_RETAIL_FLAGS);
+    Emit("STATE", "retail_flags", 0, 0,
+         fmt::format("value=0x{:08X} KinectInitialized={} KinectDisabled={}",
+                     retail_flags,
+                     (retail_flags & X_RETAIL_FLAGS::KinectInitialized) ? 1
+                                                                        : 0,
+                     (retail_flags & X_RETAIL_FLAGS::KinectDisabled) ? 1 : 0));
+  }
+  Emit("STATE", "title_id", 0, 0,
+       fmt::format("value=0x{:08X}", kernel_state->title_id()));
+  Emit("STATE", "trace_flags", 0, 0,
+       fmt::format("value=0x{:X}", g_flags));
+}
+
+bool WantsExport(const char* name) {
+  if ((g_flags & kTraceExports) == 0) {
+    return false;
+  }
+  if (g_flags & kTraceAllExports) {
+    return true;
+  }
+  if (!name) {
+    return false;
+  }
+  for (auto& substring : FilterSubstrings()) {
+    if (strstr(name, substring.c_str())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ExportCall(const char* name, uint16_t ordinal, uint32_t thread_id,
+                const uint64_t* regs) {
+  if (!WantsExport(name)) {
+    return;
+  }
+  char detail[256];
+  snprintf(detail, sizeof(detail),
+           "args=%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X",
+           static_cast<uint32_t>(regs[3]), static_cast<uint32_t>(regs[4]),
+           static_cast<uint32_t>(regs[5]), static_cast<uint32_t>(regs[6]),
+           static_cast<uint32_t>(regs[7]), static_cast<uint32_t>(regs[8]),
+           static_cast<uint32_t>(regs[9]), static_cast<uint32_t>(regs[10]));
+  Emit("EXPORT_IN", name, ordinal, thread_id, detail);
+}
+
+void ExportRet(const char* name, uint16_t ordinal, uint32_t thread_id,
+               uint64_t result) {
+  if (!WantsExport(name)) {
+    return;
+  }
+  char detail[64];
+  snprintf(detail, sizeof(detail), "ret=%08X",
+           static_cast<uint32_t>(result));
+  Emit("EXPORT_OUT", name, ordinal, thread_id, detail);
+}
+
+void Message(const char* source, uint32_t app_id, uint32_t message,
+             uint32_t buffer_ptr, uint32_t buffer_length, KernelState* state_in) {
+  if ((g_flags & kTraceMessages) == 0) {
+    return;
+  }
+  std::string detail =
+      fmt::format("app=0x{:08X} msg=0x{:08X} buf=0x{:08X} len={}",
+                  app_id, message, buffer_ptr, buffer_length);
+  if (g_flags & kTraceHexdump) {
+    auto* memory = state_in ? state_in->memory() : nullptr;
+    detail += " data=";
+    detail += Hexdump(memory, buffer_ptr, buffer_length);
+  }
+  Emit("MESSAGE", source, message, 0, detail);
+}
+
+void Notify(const char* name, uint32_t notification, uint32_t data) {
+  if ((g_flags & kTraceNotify) == 0) {
+    return;
+  }
+  Emit("NOTIFY", name, notification, 0, fmt::format("data=0x{:08X}", data));
+}
+
+void Shutdown() {
+  auto* s = state();
+  std::lock_guard<std::timed_mutex> guard(s->lock);
+  if (s->dropped) {
+    XELOGW("NUI_TRACE: {} lines dropped (lock contention)", s->dropped);
+  }
+  if (s->file) {
+    XELOGI("NUI_TRACE_END lines={}", s->seq);
+    fclose(s->file);
+    s->file = nullptr;
+  }
+  s->initialized = false;
+}
+
+}  // namespace nui_trace
+}  // namespace kernel
+}  // namespace xe
